{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pa11y Accessibility Web Scanner",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "Install Pa11y CI browser"
    }
  ]
}
